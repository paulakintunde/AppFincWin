   "id": "d18-return-refund",
   "title": "Returned laptop: plan cancelled, money restored",
   "person": "sam",
   "personOverrides": {
    "unspent": {
     "amount": 120000,
     "at": "2026-10-02"
    }
   },
   "addSeries": [
    {
     "id": "laptop-plan",
     "name": "Laptop plan",
