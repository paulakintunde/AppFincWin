    "categoryId": null,
    "pay": {
     "mode": "plan",
     "cadence": {
      "unit": "week",
      "every": 2
     },
     "count": 4,
     "termMonths": null,
     "aprText": "0",
     "fees": {
      "setup": 0,
      "perPeriod": 0,
      "end": 0
     },
     "deposit": 0,
     "tradeIn": 0,
     "quotedPayment": null,
     "firstPayment": {
      "kind": "today"
     },
     "deferredInterestTerm": false
    },
    "extras": {},
    "share": "personal",
    "foreign": null
   },
   "expect": {
    "code": "fits_month",
    "variant": "low_month",
    "legacyState": "fits",
    "band": 3,
    "month": {
     "typicalLeft": 42500,
     "lowLeft": 5000
    },
    "working": "Price 40,000 in 4 payments of 10,000 every 2 weeks at 0%, first payment today: day one 10,000, schedule 4 x 10,000. Monthly equivalent = divideHalfUp(10,000*52, 24) = 21,667 (26 fortnights a year over 12 months). October monthLeft 42,500 >= 10,000 on day one. Typical left 42,500-21,667 >= 0, but the low month (September, 5,000) - 21,667 < 0 -> fits_month with variant low_month. Band: 10,000 is below 40,000 -> 2+1 = 3."
   },
   "source": "D-18"
  },
