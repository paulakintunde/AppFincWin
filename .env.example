# ---- Client: inlined into the app bundle. Public by design; never put a secret here. ----
EXPO_PUBLIC_APP_ENV=development            # development | preview | production
EXPO_PUBLIC_SUPABASE_URL=                  # https://<ref>.supabase.co (production project; .env.local locally, EAS env for builds)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # Supabase publishable (or anon) key; RLS is the security boundary
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=          # Google OAuth *Web* client ID; used as webClientId for native sign-in (00-15)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=          # Google OAuth iOS client ID (00-15)
EXPO_PUBLIC_APPLE_SIGNIN_ENABLED=false     # true once Apple enrolment + Services ID are live (00-20); false = button visible but disabled
EXPO_PUBLIC_POSTHOG_KEY=                   # PostHog project API key (EU project, 00-13)
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   # enforced: EU host only (D-23)
EXPO_PUBLIC_ERROR_TRACKING=sentry          # posthog | sentry; Sentry chosen by the D-19 spike (docs/decisions/error-tracking.md)
EXPO_PUBLIC_SENTRY_DSN=                    # Sentry project DSN (D-19, ENV-13); org is US region, see docs/decisions/error-tracking.md
EXPO_PUBLIC_IOS_APP_STORE_ID=              # numeric App Store ID for the update-required link; set when the listing exists (Phase 11)
# ---- Build-time only: read by app.config.ts, never inlined ----
EAS_PROJECT_ID=                            # from eas init (00-14)
EXPO_OWNER=                                # Expo organisation slug (D-08)
GOOGLE_IOS_URL_SCHEME=                     # reversed iOS client ID, com.googleusercontent.apps.<id> (00-15)
SENTRY_ORG=                                # Sentry org slug; read by the @sentry/react-native/expo plugin (D-19)
SENTRY_PROJECT=                            # Sentry project slug; read by the @sentry/react-native/expo plugin (D-19)
# ---- Tooling / server only: NEVER prefix with EXPO_PUBLIC_ ----
SUPABASE_ACCESS_TOKEN=                     # personal access token for the Supabase CLI / Management API
SUPABASE_DB_PASSWORD=                      # DB password of the currently linked project (supabase db push)
SUPABASE_PROD_PROJECT_REF=                 # the one Supabase project; it is production
SUPABASE_SERVICE_ROLE_KEY=                 # Edge Functions + EAS secret only; never in client code (ENV-04)
FX_SYNC_SECRET=                            # shared secret the pg_cron job sends to the fx-sync Edge Function (00-09)
FX_MONITOR_SECRET=                         # fx-monitor's own pg_cron secret; must differ from FX_SYNC_SECRET (01-11, review IN-B03)
RESEND_API_KEY=                            # Edge Function secret only; fx-monitor's operator digest (01-11)
RESEND_FROM_EMAIL=                         # e.g. no-reply@fincwin.com; fx-monitor's digest sender (01-11)
FX_ALERT_TO_EMAIL=                         # operator address for FX staleness/hold digests (D-09); Edge Function secret only
POSTHOG_PERSONAL_API_KEY=                  # PostHog EU API queries (analytics only; error tracking moved to Sentry, D-19)
POSTHOG_PROJECT_ID=
SENTRY_AUTH_TOKEN=                         # Sentry source-map upload during EAS builds (D-19); EAS secret visibility
