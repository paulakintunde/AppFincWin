{
  "cli": { "version": ">= 24.7.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "APP_UPDATES_CHECK": "ON_ERROR_RECOVERY" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "APP_UPDATES_CHECK": "ON_LOAD" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": { "APP_UPDATES_CHECK": "ON_LOAD" },
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
